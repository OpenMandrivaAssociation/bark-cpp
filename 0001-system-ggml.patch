+// ggml 0.19 ships backends as dlopen plugins (GGML_BACKEND_DL). The
+// old ggml_backend_cpu_init / cuda_init symbols live in those plugins,
+// not in libggml. Load the registry and pick GPU-if-present.
+static ggml_backend_t bark_init_backend(int n_gpu_layers) {
+    ggml_backend_load_all();
+    ggml_backend_t backend = NULL;
+    if (n_gpu_layers > 0) {
+        backend = ggml_backend_init_best();
+    }
+    if (!backend) {
+        backend = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, NULL);
+    }
+    if (backend) {
+        fprintf(stderr, "%s: using backend %s\n", __func__, ggml_backend_name(backend));
+    }
+    return backend;
+}
+
+static void bark_backend_set_n_threads(ggml_backend_t backend, int n_threads) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    if (!dev) {
+        return;
+    }
+    ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+    auto fn = (ggml_backend_set_n_threads_t)
+        ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads");
+    if (fn) {
+        fn(backend, n_threads);
+    }
+}
